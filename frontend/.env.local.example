NEXT_PUBLIC_API_BASE=http://localhost:8080

# The voice control room's WebSocket. Served by the FastAPI backend, not a
# separate relay: /ws/voice on the backend's own host/port. Use the IPv4
# literal, not "localhost": that resolves to ::1 first on Windows while the
# backend binds IPv4 only, and a browser WebSocket will not fall back.
NEXT_PUBLIC_VOICE_WS_URL=ws://127.0.0.1:8080/ws/voice

# Server-side only, powers /api/public-ask (Gemini). /api/ask proxies to the
# backend's grounded HealthAgent instead and does not need this key. Never
# prefix with NEXT_PUBLIC_, it must not reach the browser bundle.
GEMINI_API_KEY=

# Map tiles: esri (default) or carto. Unauthenticated CARTO tiles show an API key watermark.
# NEXT_PUBLIC_MAP_TILES=esri
