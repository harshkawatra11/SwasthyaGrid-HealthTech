# Gemini (AI Studio) — used only for natural-language explanation, never prediction
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# GCP (optional, only needed once deployed — see docs/09-gcp-deployment.md)
USE_VERTEX_AI=false
USE_SECRET_MANAGER=false
GOOGLE_CLOUD_PROJECT=

# Sarvam AI: voice agent (STT, chat with tool calling, TTS). Grounds spoken
# questions in the same district/facility tools the typed Ask endpoint uses.
SARVAM_API_KEY=
SARVAM_CHAT_MODEL=sarvam-105b-conversations
SARVAM_STT_MODEL=saaras:v3-realtime
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_SPEAKER=simran
SARVAM_TTS_MODE=ws
SARVAM_STREAM_WITH_TOOLS=true
VOICE_LANGUAGE=auto

# Data source: auto (Firestore when reachable, else seed JSON), seed, or firestore.
DATA_SOURCE=auto
# Base64 or raw service-account JSON (same format the CRM uses), or a file path.
FIREBASE_SERVICE_ACCOUNT=
FIREBASE_SERVICE_ACCOUNT_FILE=

# Supply chain simulation (simulated seconds per real second; 1 = real time).
LOGISTICS_TIME_SCALE=60
LOGISTICS_SCENARIO_START=
LOGISTICS_AUTO_POD_MINUTES=240
LOGISTICS_BACKGROUND_TRAFFIC=true
LOGISTICS_TICK=true
LOGISTICS_ADMIN_ENABLED=true
# Shared secret with the CRM for proof-of-delivery calls. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
LOGISTICS_SERVICE_TOKEN=
LOGISTICS_STATE_PATH=.runtime/logistics_state.json

ENVIRONMENT=local
